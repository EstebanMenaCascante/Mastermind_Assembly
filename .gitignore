# ==========================
# Archivos generados por TASM / TLINK
# (git distingue mayusculas, por eso van ambas versiones)
# ==========================
*.obj
*.OBJ
*.map
*.MAP
*.lst
*.LST
*.crf
*.CRF
*.xrf
*.XRF

# ==========================
# Ejecutables
# Se ignoran en cualquier lugar, excepto /bin (entregable E2)
# y /herramientas (si se incluyen TASM/TLINK/TD)
# ==========================
*.exe
*.EXE
*.com
*.COM
!bin/*.exe
!bin/*.EXE
!bin/*.com
!bin/*.COM
!herramientas/**

# ==========================
# Turbo Debugger (archivos de sesion y configuracion)
# ==========================
*.td
*.TD
*.tr
*.TR
*.tds
*.TDS
!herramientas/**

# ==========================
# IDEs y entornos
# ==========================
**/.idea/
*.iml
**/.vscode/

# ==========================
# Archivos del sistema
# ==========================
.DS_Store
Thumbs.db

# ==========================
# Sistema de notificaciones (si genera archivos)
# ==========================
/outbox/